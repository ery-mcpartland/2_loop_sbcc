    RowBox[{"P4", "==", 
     RowBox[{"r", ".", "r"}]}], "&&", 
    RowBox[{"P5", "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "p", "-", "q"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"r", "+", "p", "-", "q"}], ")"}]}]}], "&&", 
    RowBox[{"P8", "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "p"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"r", "+", "p"}], ")"}]}]}], "&&", 
    RowBox[{"P7", "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "+", "p", "-", "q"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"l", "+", "p", "-", "q"}], ")"}]}]}], "&&", 
    RowBox[{"P9", "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "+", "q"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"l", "+", "q"}], ")"}]}]}], "&&", 
    RowBox[{
     RowBox[{"p", ".", "p"}], "==", 
     RowBox[{"mb", "^", "2"}]}], "&&", 
