    RowBox[{"\"\<a\>\"", ",", "int_"}], "]"}], ":=", 
   RowBox[{"int", "/.", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"r", "->", 
       RowBox[{"P1", " ", "p"}]}], ",", 
      RowBox[{"l", "->", 
       RowBox[{"P2", " ", "q"}]}]}], "}"}]}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ReduceToScalar", "[", 
   RowBox[{"i_", ",", "int_"}], "]"}], ":=", 
  RowBox[{"Simplify", "[", 
   RowBox[{"FermionLineExpand", "[", 
    RowBox[{
     RowBox[{"TensorReduction", "[", 
      RowBox[{"i", ",", "int"}], "]"}], ",", 
     RowBox[{"ChisholmExpand", "->", "False"}], ",", 
     RowBox[{"GordonIdentity", "->", "False"}]}], "]"}], "]"}]}]}], "Input",
 CellChangeTimes->{{3.94836234156971*^9, 
  3.948362341570284*^9}},ExpressionUUID->"6fe30a4c-38f7-4d57-8493-\
