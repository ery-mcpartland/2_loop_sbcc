         RowBox[{"p", ".", "p"}], " ", 
         RowBox[{"q", ".", "q"}]}]}]]}]}], ",", 
    RowBox[{"Ipql", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"l", ".", "q"}], " ", 
         RowBox[{"p", ".", "p"}]}], "-", 
        RowBox[{
