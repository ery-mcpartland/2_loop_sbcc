}, Open  ]],

Cell["\<\
Now, given that we know l^{\\nu}->I_{pl} p^{\\nu}+I_{ql} q^{\\nu} and \
r^{\\nu}->I_{pr} p^{\\nu}+I_{qr} q^{\\nu} we can simply apply replacement \
rules\
\>", "Text",
 CellChangeTimes->{{3.948370339455803*^9, 
  3.948370412084812*^9}},ExpressionUUID->"0b41af26-6e59-4c6f-ad37-\
ea8e064c8aa6"],

