Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"TensorReduction", "[", 
    RowBox[{"\"\<a\>\"", ",", "int_"}], "]"}], ":=", 
   RowBox[{"int", "/.", 
