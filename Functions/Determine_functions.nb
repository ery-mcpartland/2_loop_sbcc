Cell[CellGroupData[{

Cell["General form", "Subsection",
 CellChangeTimes->{{3.948363049377305*^9, 
  3.948363064406438*^9}},ExpressionUUID->"43ac6627-89d8-4ed4-b8e6-\
719a9cba032c"],

Cell["\<\
Let an integral I^{\\nu}=A l^{\\nu}+B r^{\\nu}. We know once the integral has \
been completed we can only have dependence on external momenta, p and q. This \
gives us that 
I^{\\nu}=A (I_{pl} p^{\\nu}+I_{ql} q^{\\nu}) + B (I_{pr} p^{\\nu}+I_{qr} \
q^{\\nu}). Focussing for a moment on B=0 (l and r are independent so we are \
free to consider just l or just r).
p.I=A p.l=A(I_{pl}p.p+I_{ql}p.q) and q.I=A q.l=A(I_{pl}p.q+I_{ql}q.q).
 This is a set of simultaneous equations we can solve.\
\>", "Text",
 CellChangeTimes->{{3.948363073281229*^9, 3.948363197385714*^9}, {
   3.9483633249139347`*^9, 3.9483635785871267`*^9}, 
   3.9483637115660048`*^9},ExpressionUUID->"fafdbbe8-6de4-4d1e-bd73-\
911e0d97da79"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LDot", "[", 
      RowBox[{"p", ",", "l"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Ipl", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", "p"}], "]"}]}], " ", "+", 
      RowBox[{"Iql", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", "q"}], "]"}]}]}]}], "&&", 
    RowBox[{
     RowBox[{"LDot", "[", 
      RowBox[{"q", ",", "l"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Ipl", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", "q"}], "]"}]}], " ", "+", " ", 
      RowBox[{"Iql", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"q", ",", "q"}], "]"}]}]}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"Ipl", ",", "Iql"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.948363583526486*^9, 3.948363591918675*^9}, {
  3.948363629251246*^9, 3.948363676595248*^9}, {3.948370464586679*^9, 
  3.948370503036826*^9}, {3.948531210990862*^9, 
  3.9485312130787992`*^9}},ExpressionUUID->"627d041a-9da8-4398-aee1-\
4de0f62baa31"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Ipl", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"l", ".", "q"}]}], " ", 
         RowBox[{"p", ".", "q"}]}], "+", 
        RowBox[{
         RowBox[{"l", ".", "p"}], " ", 
         RowBox[{"q", ".", "q"}]}]}], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"p", ".", "q"}], ")"}], "2"], "-", 
        RowBox[{
         RowBox[{"p", ".", "p"}], " ", 
         RowBox[{"q", ".", "q"}]}]}]]}]}], ",", 
    RowBox[{"Iql", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"l", ".", "q"}], " ", 
         RowBox[{"p", ".", "p"}]}], "-", 
        RowBox[{
         RowBox[{"l", ".", "p"}], " ", 
         RowBox[{"p", ".", "q"}]}]}], 
       RowBox[{
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"p", ".", "q"}], ")"}], "2"], "-", 
        RowBox[{
         RowBox[{"p", ".", "p"}], " ", 
         RowBox[{"q", ".", "q"}]}]}]]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.948363677191269*^9, 3.9483705654307632`*^9},
 CellLabel->"Out[3]=",ExpressionUUID->"0bb5c606-a86f-42c5-a30e-fecce6c39e80"]
}, Open  ]],

Cell["\<\
Similarly for A=0 we have
p.I=B p.r=B(I_{pr}p.p+I_{qr}p.q) and q.I=B q.r=B(I_{pr}p.q+I_{qr}q.q)\
\>", "Text",
 CellChangeTimes->{{3.948363689583251*^9, 
  3.9483637418708677`*^9}},ExpressionUUID->"8c3ebca9-9ccc-4adb-b612-\
fa914542c711"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LDot", "[", 
      RowBox[{"p", ",", "r"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Ipr", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", "p"}], "]"}]}], "+", 
      RowBox[{"Iqr", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", "q"}], "]"}]}]}]}], "&&", 
    RowBox[{
     RowBox[{"LDot", "[", 
      RowBox[{"q", ",", "r"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Ipr", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", "q"}], "]"}]}], " ", "+", " ", 
      RowBox[{"Iqr", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"q", ",", "q"}], "]"}]}]}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"Ipr", ",", "Iqr"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.948363749489332*^9, 3.948363769874009*^9}, {
  3.948370516493012*^9, 3.948370559951735*^9}},
 CellLabel->"In[2]:=",ExpressionUUID->"d32ddbd0-30d7-49e6-8f28-9a22e7dd8aa5"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Ipr", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"p", ".", "r"}], " ", 
         RowBox[{"q", ".", "q"}]}], "-", 
