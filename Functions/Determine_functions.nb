         RowBox[{"LTensor", "[", 
          RowBox[{"q", ",", "\[Nu]"}], "]"}]}]}], "/.", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"Ipl", "\[Rule]", 
          RowBox[{"-", 
           FractionBox[
