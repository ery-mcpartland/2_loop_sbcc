     RowBox[{
      RowBox[{"r", "->", 
       RowBox[{"P1", " ", "p"}]}], ",", 
      RowBox[{"l", "->", 
       RowBox[{"P2", " ", "q"}]}]}], "}"}]}]}], "\n"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"ReduceToScalar", "[", 
   RowBox[{"i_", ",", "int_"}], "]"}], ":=", 
  RowBox[{"Simplify", "[", 
