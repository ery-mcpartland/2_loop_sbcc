      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"p", ".", "q"}]}], " ", 
         RowBox[{"p", ".", "r"}]}], "+", 
        RowBox[{
         RowBox[{"p", ".", "p"}], " ", 
         RowBox[{"q", ".", "r"}]}]}], 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"p", ".", "q"}], ")"}], "2"]}], "+", 
        RowBox[{
         RowBox[{"p", ".", "p"}], " ", 
         RowBox[{"q", ".", "q"}]}]}]]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{{3.9483637653154373`*^9, 3.948363770414381*^9}, 
   3.9483705607016497`*^9, {3.948531634679817*^9, 3.9485316443772717`*^9}},
 CellLabel->"Out[8]=",ExpressionUUID->"3700bcc1-4319-4570-bbb5-b77eeeab63d9"]
}, Open  ]],

Cell["\<\
Now, given that we know l^{\\nu}->I_{pl} p^{\\nu}+I_{pql}(p- q)^{\\nu} and \
r^{\\nu}->I_{pr} p^{\\nu}+I_{pqr}(p- q)^{\\nu} we can simply apply \
replacement rules\
\>", "Text",
 CellChangeTimes->{{3.948370339455803*^9, 3.948370412084812*^9}, {
  3.948531659619011*^9, 3.948531664372463*^9}, {3.948531702239216*^9, 
  3.9485317071463013`*^9}},ExpressionUUID->"b0b3c817-9cd3-4bf6-bb94-\
87f5a67fc301"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"Simplify", "[", 
   RowBox[{"PropagatorReplace", "[", 
    RowBox[{"\"\<a\>\"", ",", 
     RowBox[{
      RowBox[{
       RowBox[{"Ipl", " ", 
        RowBox[{"LTensor", "[", 
         RowBox[{"p", ",", "\[Nu]"}], "]"}]}], "+", 
       RowBox[{"Ipql", " ", 
        RowBox[{"LTensor", "[", 
         RowBox[{
          RowBox[{"p", "-", "q"}], ",", "\[Nu]"}], "]"}]}]}], "/.", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"Ipl", "\[Rule]", 
         RowBox[{"-", 
          FractionBox[
           RowBox[{
            RowBox[{
             RowBox[{"-", 
              RowBox[{"l", ".", "q"}]}], " ", 
             RowBox[{"p", ".", "p"}]}], "+", 
            RowBox[{
             RowBox[{"l", ".", "p"}], " ", 
