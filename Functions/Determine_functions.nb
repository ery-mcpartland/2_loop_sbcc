Cell[CellGroupData[{

Cell["General form II", "Subsection",
 CellChangeTimes->{{3.948363049377305*^9, 3.948363064406438*^9}, {
  3.948531228630053*^9, 
  3.948531229269552*^9}},ExpressionUUID->"b47349bb-76db-4263-bf6c-\
170e8fb96b7a"],

Cell["\<\
Let an integral I^{\\nu}=A l^{\\nu}+B r^{\\nu}. We know once the integral has \
been completed we can only have dependence on external momenta, p and q. This \
gives us that 
I^{\\nu}=A (I_{pl} p^{\\nu}+I_{pql} (p-q)^{\\nu}) + B (I_{pr} \
p^{\\nu}+I_{pqr}(p- q)^{\\nu}). Focussing for a moment on B=0 (l and r are \
independent so we are free to consider just l or just r).
p.I=A p.l=A(I_{pl}p.p+I_{pql}(p-q).q) and q.I=A \
q.l=A(I_{pl}p.q+I_{pql}(p-q).q).
 This is a set of simultaneous equations we can solve.\
\>", "Text",
 CellChangeTimes->{{3.948363073281229*^9, 3.948363197385714*^9}, {
   3.9483633249139347`*^9, 3.9483635785871267`*^9}, 3.9483637115660048`*^9, {
   3.948531289249159*^9, 
   3.948531382263258*^9}},ExpressionUUID->"6516395d-ad56-4830-b42a-\
7a8da570b63b"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LDot", "[", 
      RowBox[{"p", ",", "l"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Ipl", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", "p"}], "]"}]}], " ", "+", 
      RowBox[{"Ipql", 
       RowBox[{"(", " ", 
        RowBox[{"LDot", "[", 
         RowBox[{"p", ",", 
          RowBox[{"p", "-", "q"}]}], "]"}], ")"}]}]}]}], "&&", 
    RowBox[{
     RowBox[{"LDot", "[", 
      RowBox[{
       RowBox[{"p", "-", "q"}], ",", "l"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Ipl", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{
         RowBox[{"p", "-", "q"}], ",", "p"}], "]"}]}], " ", "+", " ", 
      RowBox[{"Ipql", " ", 
       RowBox[{"(", 
        RowBox[{"LDot", "[", 
         RowBox[{
          RowBox[{"p", "-", "q"}], ",", 
          RowBox[{"p", "-", "q"}]}], "]"}], ")"}]}]}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"Ipl", ",", "Ipql"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.948363583526486*^9, 3.948363591918675*^9}, {
  3.948363629251246*^9, 3.948363676595248*^9}, {3.948370464586679*^9, 
  3.948370503036826*^9}, {3.948531210990862*^9, 3.9485312130787992`*^9}, {
  3.948531430958643*^9, 3.9485315088880453`*^9}, {3.948531541307558*^9, 
  3.9485315498133917`*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"8cd4b3d3-4d57-47db-88e4-cdf82dc0d018"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"Ipl", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"l", ".", "q"}]}], " ", 
         RowBox[{"p", ".", "p"}]}], "+", 
        RowBox[{
         RowBox[{"l", ".", "p"}], " ", 
         RowBox[{"p", ".", "q"}]}], "+", 
        RowBox[{
         RowBox[{"l", ".", "q"}], " ", 
         RowBox[{"p", ".", "q"}]}], "-", 
        RowBox[{
         RowBox[{"l", ".", "p"}], " ", 
         RowBox[{"q", ".", "q"}]}]}], 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"p", ".", "q"}], ")"}], "2"]}], "+", 
        RowBox[{
         RowBox[{"p", ".", "p"}], " ", 
         RowBox[{"q", ".", "q"}]}]}]]}]}], ",", 
    RowBox[{"Ipql", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"l", ".", "q"}], " ", 
         RowBox[{"p", ".", "p"}]}], "-", 
        RowBox[{
         RowBox[{"l", ".", "p"}], " ", 
         RowBox[{"p", ".", "q"}]}]}], 
       RowBox[{
        RowBox[{"-", 
         SuperscriptBox[
          RowBox[{"(", 
           RowBox[{"p", ".", "q"}], ")"}], "2"]}], "+", 
        RowBox[{
         RowBox[{"p", ".", "p"}], " ", 
         RowBox[{"q", ".", "q"}]}]}]]}]}]}], "}"}], "}"}]], "Output",
 CellChangeTimes->{3.948363677191269*^9, 3.9483705654307632`*^9, 
  3.9485315577015467`*^9},
 CellLabel->"Out[6]=",ExpressionUUID->"1f4022ee-af7a-45e5-a578-ec592a4aa0af"]
}, Open  ]],

Cell["\<\
Similarly for A=0 we have
p.I=B p.r=B(I_{pr}p.p+I_{qr}p.q) and q.I=B q.r=B(I_{pr}p.q+I_{qr}q.q)\
\>", "Text",
 CellChangeTimes->{{3.948363689583251*^9, 
  3.9483637418708677`*^9}},ExpressionUUID->"725513b9-1214-48fa-8dfd-\
cd4d15f3dd08"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"LDot", "[", 
      RowBox[{"p", ",", "r"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Ipr", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", "p"}], "]"}]}], "+", 
      RowBox[{"Ipqr", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{"p", ",", 
         RowBox[{"p", "-", "q"}]}], "]"}]}]}]}], "&&", 
    RowBox[{
     RowBox[{"LDot", "[", 
      RowBox[{
       RowBox[{"p", "-", "q"}], ",", "r"}], "]"}], "==", 
     RowBox[{
      RowBox[{"Ipr", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{
         RowBox[{"p", "-", "q"}], ",", "p"}], "]"}]}], " ", "+", " ", 
      RowBox[{"Ipqr", " ", 
       RowBox[{"LDot", "[", 
        RowBox[{
         RowBox[{"p", "-", "q"}], ",", 
         RowBox[{"p", "-", "q"}]}], "]"}]}]}]}]}], ",", 
   RowBox[{"{", 
    RowBox[{"Ipr", ",", "Ipqr"}], "}"}]}], "]"}]], "Input",
 CellChangeTimes->{{3.948363749489332*^9, 3.948363769874009*^9}, {
  3.948370516493012*^9, 3.948370559951735*^9}, {3.948531574353619*^9, 
  3.9485315998984337`*^9}, {3.9485316410615664`*^9, 3.948531643633115*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"2e97fc38-157c-420b-b6d0-e315b17251ac"],

Cell[BoxData[
 RowBox[{"{", 
