Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"Solve", "[", 
  RowBox[{
   RowBox[{
    RowBox[{"P2", "==", 
     RowBox[{
      RowBox[{"l", " ", ".", " ", "l"}], "-", 
      RowBox[{"mc", "^", "2"}]}]}], "&&", 
    RowBox[{"P3", "==", 
     RowBox[{
      RowBox[{
       RowBox[{"(", 
        RowBox[{"l", "+", "r"}], ")"}], ".", 
       RowBox[{"(", 
        RowBox[{"l", "+", "r"}], ")"}]}], "-", 
      RowBox[{"mc", "^", "2"}]}]}], "&&", 
    RowBox[{"P4", "==", 
     RowBox[{"r", ".", "r"}]}], "&&", 
    RowBox[{"P5", "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "p", "-", "q"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"r", "+", "p", "-", "q"}], ")"}]}]}], "&&", 
    RowBox[{"P8", "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"r", "+", "p"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"r", "+", "p"}], ")"}]}]}], "&&", 
    RowBox[{"P7", "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "+", "p", "-", "q"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"l", "+", "p", "-", "q"}], ")"}]}]}], "&&", 
    RowBox[{"P9", "==", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{"l", "+", "q"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"l", "+", "q"}], ")"}]}]}], "&&", 
    RowBox[{
     RowBox[{"p", ".", "p"}], "==", 
     RowBox[{"mb", "^", "2"}]}], "&&", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{"p", "-", "q"}], ")"}], ".", 
      RowBox[{"(", 
       RowBox[{"p", "-", "q"}], ")"}]}], "==", "0"}], "&&", 
    RowBox[{
     RowBox[{"q", ".", "q"}], "==", "q2"}]}], ",", 
   RowBox[{"{", 
