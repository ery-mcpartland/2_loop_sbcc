   RowBox[{
    RowBox[{"Ipr", "\[Rule]", 
     RowBox[{"-", 
      FractionBox[
       RowBox[{
        RowBox[{
         RowBox[{"-", 
          RowBox[{"p", ".", "q"}]}], " ", 
         RowBox[{"p", ".", "r"}]}], "+", 
        RowBox[{
         RowBox[{"p", ".", "r"}], " ", 
