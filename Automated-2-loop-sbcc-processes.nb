 RowBox[{
  RowBox[{"a1Op1", "=", 
   RowBox[{"Simplify", "[", 
    RowBox[{"CreateAmplitude", "[", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "CFa"}], " ", 
       RowBox[{"(", "Qb", ")"}], 
       RowBox[{"DiracMatrix", "[", 
        RowBox[{
         RowBox[{"LTensor", "[", 
          RowBox[{"\[Gamma]", ",", "\[Nu]"}], "]"}], ",", 
         RowBox[{"\[Gamma]", " ", ".", " ", 
          RowBox[{"(", 
           RowBox[{"r", "+", "p", "-", "q"}], ")"}]}], ",", 
         RowBox[{"LTensor", "[", 
          RowBox[{"\[Gamma]", ",", "\[Alpha]"}], "]"}], ",", 
         "\[DoubleStruckCapitalP]L", ",", 
         RowBox[{
          RowBox[{"\[Gamma]", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{"l", "+", "r"}], ")"}]}], "+", 
          RowBox[{"mc", " ", "\[DoubleStruckOne]"}]}], ",", 
         RowBox[{"LTensor", "[", 
          RowBox[{"\[Gamma]", ",", "\[Nu]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"\[Gamma]", " ", ".", " ", 
           RowBox[{"(", "l", ")"}]}], "+", 
          RowBox[{"mc", " ", "\[DoubleStruckOne]"}]}], ",", 
         RowBox[{"LTensor", "[", 
          RowBox[{"\[Gamma]", ",", "\[Alpha]"}], "]"}], ",", 
         "\[DoubleStruckCapitalP]L", ",", 
         RowBox[{
          RowBox[{"\[Gamma]", " ", ".", " ", 
           RowBox[{"(", 
            RowBox[{"p", "-", "q"}], ")"}]}], "+", 
          RowBox[{"mb", " ", "\[DoubleStruckOne]"}]}], ",", 
         RowBox[{"LTensor", "[", 
          RowBox[{"\[Gamma]", ",", "\[Mu]"}], "]"}]}], "]"}]}], ",", 
      RowBox[{"P2", " ", "P3", " ", "P4", " ", "P5", " ", 
